                "static": ""
              }
            }
          },
          {
            "name": "members",
            "set": {
              "computed_optional_required": "optional",
              "description": "List of team members",
              "element_type": {
                "string": {}
              }
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "required",
              "description": "Team name",
              "plan_modifiers": [
                {
